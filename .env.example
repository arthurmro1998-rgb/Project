# For local development with `vercel dev`, copy this file to .env.local
# For production, add these in Vercel → Project → Settings → Environment Variables

STRIPE_SECRET_KEY=sk_test_your_secret_key_here
# Create a Stripe product named "product" at $10 USD, then paste its Price ID here
STRIPE_PRICE_ID=price_your_price_id_here
# From Stripe Dashboard → Developers → Webhooks → your endpoint's Signing secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# Neon Postgres pooled connection string
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require

# Base URL used to build links in emails (verify/reset), e.g. https://your-site.vercel.app
APP_URL=

# Optional until an email provider is set up — signup/reset/verify still work,
# emails just get logged instead of sent until these are set.
RESEND_API_KEY=
EMAIL_FROM=

# Optional: creates one admin account on first deploy if no admin exists yet.
# Remove or change the password after first login.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
